# ─── Environment switch ──────────────────────────────────────────────────
# development = auto-reload on, debug logging
# production  = no reload, info logging, dev placeholders below rejected
ENVIRONMENT=development

# ─── Where the process listens ───────────────────────────────────────────
# 0.0.0.0 accepts traffic from outside the machine (required on
# DigitalOcean); use 127.0.0.1 to keep it local-only.
HOST=0.0.0.0
PORT=8000

# ─── Where clients reach the server ──────────────────────────────────────
# The public address of this API. Leave blank locally.
#   App Platform: https://<your-app>.ondigitalocean.app  (or ${APP_URL})
#   Droplet:      http://<droplet-ip>:8000
# Used for the LinkedIn redirect URI and the /docs "servers" entry.
PUBLIC_BASE_URL=

# Allowed browser origins: "*" or a comma-separated list.
CORS_ORIGINS=*

# Set to false to hide /docs, /redoc and /openapi.json.
DOCS_ENABLED=true

# ─── Database ────────────────────────────────────────────────────────────
# Local dev Postgres (docker run -e POSTGRES_PASSWORD=acrova -e POSTGRES_USER=acrova \
#   -e POSTGRES_DB=acrova -p 5432:5432 postgres:16)
# On App Platform this is a RUN_TIME secret holding the Supabase pooler URL:
# postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://acrova:acrova@localhost:5432/acrova

# ─── Auth ────────────────────────────────────────────────────────────────
# JWT bearer tokens issued after LinkedIn login. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# LinkedIn OAuth app (https://www.linkedin.com/developers/apps), OpenID Connect
# product enabled. Redirect URI must match exactly what's configured there.
# Leave LINKEDIN_REDIRECT_URI blank to derive it from PUBLIC_BASE_URL as
# <base-url>/api/auth/linkedin/callback.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# ─── Storage ─────────────────────────────────────────────────────────────
# Supabase project storing candidate CVs. Service role key is required to
# mint signed upload URLs; never expose it to clients.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=cvs

# ─── Claude API ──────────────────────────────────────────────────────────
# Used for CV claim extraction and quiz generation.
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx
